# ==========================================
# 🛡️ GuardianStock Global .gitignore
# ==========================================

# --- [ .NET / Visual Studio ] ---
# User-specific files
.agent
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
[Oo]ut/

# Publishing & Artifacts
publish/
*.pubxml
*.nupkg
*.snupkg
BenchmarkDotNet.Artifacts/
artifacts/

# Testing & Coverage
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
healthchecksdb

# --- [ Node.js / Frontend (web-ui) ] ---
# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/
.lovable/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- [ Environment & Secrets ] ---
# NEVER commit secrets
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow example files
!.env.example



# --- [ OS & Editors ] ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.scratch

# --- [ Project Specific Paths ] ---
# Update these if your folder names change
/src/GuardianStock.API/temp/
/src/GuardianStock.API/wwwroot/temp/
/.github/copilot-instructions.md
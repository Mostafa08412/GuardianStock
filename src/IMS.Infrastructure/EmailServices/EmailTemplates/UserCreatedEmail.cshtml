@model IMS.Infrastructure.EmailServices.EmailTemplates.UserCreatedEmailModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        body { margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f0faf8; color: #1a1a2e; line-height: 1.6; }
        .wrapper { width: 100%; background-color: #f0faf8; padding: 40px 0; }
        .container { width: 90%; max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08); }
        .header { background: linear-gradient(135deg, #2bb5a0, #1a9c8b); padding: 32px 24px; text-align: center; }
        .header-logo { font-size: 14px; font-weight: 600; color: rgba(255,255,255,0.85); letter-spacing: 0.5px; margin-bottom: 4px; }
        .header h2 { margin: 8px 0 0; font-size: 22px; color: #ffffff; font-weight: 700; }
        .body-content { padding: 32px 28px; }
        .body-content p { margin: 0 0 14px; font-size: 15px; color: #4a5568; }
        .credentials-card { background-color: #f7faf9; border: 1px solid #e2ede9; border-left: 4px solid #2bb5a0; padding: 20px; border-radius: 10px; margin: 20px 0; }
        .credentials-card table { width: 100%; border-collapse: collapse; }
        .credentials-card td { padding: 8px 0; font-size: 14px; vertical-align: top; }
        .credentials-card .label { color: #718096; font-weight: 500; width: 35%; }
        .credentials-card .value { color: #1a1a2e; font-weight: 600; }
        .warning { background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 12px 16px; margin: 20px 0; font-size: 13px; color: #92400e; }
        .warning-icon { margin-right: 6px; }
        .btn-wrapper { text-align: center; margin: 28px 0 8px; }
        .btn { display: inline-block; padding: 14px 36px; background: linear-gradient(135deg, #2bb5a0, #1a9c8b); color: #ffffff !important; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px; letter-spacing: 0.3px; }
        .footer { text-align: center; padding: 20px 28px 28px; border-top: 1px solid #edf2f7; }
        .footer p { margin: 4px 0; font-size: 12px; color: #a0aec0; }
        .footer .brand { font-weight: 600; color: #2bb5a0; }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="container">
            <div class="header">
                <div class="header-logo">📦 InventoryPro</div>
                <h2>Welcome to the Team!</h2>
            </div>

            <div class="body-content">
                <p>Hello <strong>@Model.FullName</strong>,</p>
                <p>Your account has been created by an administrator. Below are your login credentials to get started:</p>

                <div class="credentials-card">
                    <table>
                        <tr>
                            <td class="label">Full Name</td>
                            <td class="value">@Model.FullName</td>
                        </tr>
                        <tr>
                            <td class="label">Email</td>
                            <td class="value">@Model.Email</td>
                        </tr>
                        <tr>
                            <td class="label">Password</td>
                            <td class="value">@Model.Password</td>
                        </tr>
                    </table>
                </div>

                <div class="warning">
                    <span class="warning-icon">⚠️</span> For security reasons, please change your password after your first login.
                </div>

                <div class="btn-wrapper">
                    <a href="@Model.LoginUrl" class="btn">Sign In →</a>
                </div>
            </div>

            <div class="footer">
                <p>If you did not expect this email, please contact your administrator.</p>
                <p class="brand">InventoryPro · Management System</p>
            </div>
        </div>
    </div>
</body>
</html>

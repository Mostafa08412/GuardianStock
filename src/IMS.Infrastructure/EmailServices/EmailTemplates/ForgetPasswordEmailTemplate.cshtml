@model IMS.Infrastructure.EmailServices.EmailTemplates.ForgetPasswordEmailModel

@{
    Layout = null;
    var primaryColor = "#1a73e8";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body style="font-family: 'Google Sans', Roboto, Arial, sans-serif; background-color: #ffffff; margin: 0; padding: 40px 20px;">
    
    <div style="max-width: 600px; margin: 0 auto; border: 1px solid #dadce0; border-radius: 8px; overflow: hidden;">
        
       

        <div style="padding: 8px 40px 40px 40px; color: #3c4043;">
            <h1 style="font-size: 24px; font-weight: 400; color: #202124; margin-bottom: 24px;">Verify your identity</h1>
            
            <p style="font-size: 14px; line-height: 1.5; color: #3c4043;">
                Hi @Model.Name,
            </p>
            
            <p style="font-size: 14px; line-height: 1.5; color: #3c4043;">
                A password reset request was made for your account associated with <strong>@Model.EmailAddress</strong>. 
                Use this verification code to proceed:
            </p>

            <div style="background-color: #f8f9fa; border-radius: 4px; padding: 24px; margin: 32px 0; text-align: center;">
                <div style="font-size: 11px; color: #70757a; margin-bottom: 8px; letter-spacing: 0.8px; text-transform: uppercase; font-weight: 500;">Verification code</div>
                <div style="font-size: 36px; font-weight: 500; letter-spacing: 10px; color: @primaryColor; font-family: 'Google Sans', Roboto, Mono, monospace;">
                    @Model.Otp
                </div>
            </div>

            <p style="font-size: 13px; color: #d93025; background-color: #fce8e6; padding: 12px; border-radius: 4px; display: inline-block;">
                This code is valid for <strong>30 seconds</strong>.
            </p>

            <p style="font-size: 13px; color: #70757a; margin-top: 32px; line-height: 1.5;">
                If you didn't request this code, someone may be trying to access your account. 
                <strong>Do not share this code with anyone.</strong>
            </p>

            <div style="margin-top: 48px; border-top: 1px solid #e8eaed; padding-top: 24px;">
                <p style="font-size: 11px; color: #9aa0a6; text-align: center;">
                    You received this email because a security action was triggered for your account.<br>
                    &copy; 2026 FluxStore. All rights reserved.
                </p>
            </div>
        </div>
    </div>

</body>
</html>
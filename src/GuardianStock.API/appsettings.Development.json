{
  "ConnectionStrings": {
    "DefaultConnection": "Server={DB_SERVER};Database={DB_NAME};User Id={DB_USER};Password={DB_PASSWORD};",
    "Redis": "REDIS_SERVER_URL:PORT"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Aspire": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {

        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      },
      {

        "Name": "OpenTelemetry"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "IMS"
    }
  },

  "TokenSettings": {
    "SecretKey": "{LONG_RANDOM_SECURE_KEY}",
    "Issuer": "{API_URL}",
    "Audience": "{FRONTEND_URL}",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryMinutes": 10080
  },
  "Seeding": {
    "UseSeedData": true

  },
  "SmtpSettings": {
    "SmtpHost": "{SMTP_SERVER_ADDRESS}",
    "SmtpPort": 587,
    "UseSSL": true,
    "FromEmail": "{SYSTEM_SENDER_EMAIL}",
    "Password": "{EMAIL_APP_PASSWORD}"
  },

  "CorsSettings": {
    "PolicyName": "IMS_Cors_Policy",
    "AllowedOrigins": [
      "{LOCAL_FRONTEND_URL}",
      "{PRODUCTION_FRONTEND_URL}"
    ]
  },

  "ExternalServices": {
    "PaymentGatewayKey": "{API_KEY_HERE}",
    "MapServiceUrl": "https://api.service.com/v1"
  },
  "FrontendSettings": {
    "BaseUrl": "http://localhost:8080"
  },
  "OpenTelemetry": {
    "ServiceName": "GuardianStock.API",
    "Endpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*"
}
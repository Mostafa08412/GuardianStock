{
  "ConnectionStrings": {
    "DefaultConnection": "Server={DB_SERVER};Database={DB_NAME};User Id={DB_USER};Password={DB_PASSWORD};"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq" 

    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Aspire": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {

        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "seq-server-url"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "GuardianStock"
    }
  },

  "TokenSettings": {
    "SecretKey": "{LONG_RANDOM_SECURE_KEY}",
    "Issuer": "{API_URL}",
    "Audience": "{FRONTEND_URL}",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryMinutes": 10080
  },
  "Seeding": {
    "UseSeedData": true

  },
  "SmtpSettings": {
    "SmtpHost": "{SMTP_SERVER_ADDRESS}",
    "SmtpPort": 587,
    "UseSSL": true,
    "FromEmail": "{SYSTEM_SENDER_EMAIL}",
    "Password": "{EMAIL_APP_PASSWORD}"
  },

  "CorsSettings": {
    "PolicyName": "GuardianStock_Cors_Policy",
    "AllowedOrigins": [
      "{LOCAL_FRONTEND_URL}",
      "{PRODUCTION_FRONTEND_URL}"
    ]
  },

  "FrontendSettings": {
    "BaseUrl": "LOCAL_FRONTEND_BASE_URL"
  },
  "AllowedHosts": "*"
}
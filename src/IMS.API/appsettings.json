{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      //{
      //  "Name": "Console",
      //  "Args": {
      //    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
      //  }
      //},
      {
        "Name": "File",
        "Args": {
          "path": "logs/ims-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithEnvironmentName", "WithSpan" ]
  },
  "AllowedHosts": "*",
  
    "ConnectionStrings": {
      "DefaultConnection": "Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
    },
    "TokenSettings": {
      "Issuer": "http://localhost:5089",
      "Audience": "http://localhost:5089",
      "AccessTokenExpiryMinutes": 1,
      "RefreshTokenExpiryMinutes": 1000,
      "SecretKey": "YOUR_LONG_SECURE_RANDOM_SECRET_KEY_HERE"
    },
    "SmtpSettings": {
      "SmtpHost": "smtp.yourprovider.com",
      "SmtpPort": 587,
      "FromEmail": "noreply@yourdomain.com",
      "Password": "YOUR_SMTP_PASSWORD_OR_APP_PASSWORD"
    }
  }
